    },
    {
      "id": "reg",
      "name": "Векторные регистры",
      "role": "XMM0 / XMM1 (128 бит)",
      "kind": "state",
      "defaultState": "пусто"
    },
    {
      "id": "alu",
      "name": "SIMD АЛУ ядра",
      "role": "1 векторная инструкция",
      "kind": "state",
      "defaultState": "ожидание"
    }
  ],
  "links": [
    { "id": "mr", "downLabel": "↓ _mm_loadu_ps", "upLabel": "↑ _mm_storeu_ps" },
    { "id": "ra", "downLabel": "↓ va, vb", "upLabel": "↑ sum (4 × f32)" }
  ],
  "steps": [
    {
      "label": "Загрузка векторов",
      "explain": "<code>_mm_loadu_ps</code> загружает сразу 4 числа <code>f32</code> (16 байт) из памяти в 128-битные векторные регистры <code>XMM0</code> и <code>XMM1</code> без требования строгого выравнивания.",
      "lines": { "1": "active", "2": "active" },
