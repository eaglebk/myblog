{
  "title": "Как SIMD обрабатывает 4 числа <code>f32</code> за одну инструкцию",
  "interval": 2600,
  "code": [
    "unsafe {",
    "    let va = _mm_loadu_ps(a.as_ptr());",
    "    let vb = _mm_loadu_ps(b.as_ptr());",
    "    let sum = _mm_add_ps(va, vb);",
    "    _mm_storeu_ps(out.as_mut_ptr(), sum);",
    "}"
  ],
  "nodes": [
    {
      "id": "mem",
      "name": "Память (RAM)",
      "role": "4 элемента f32 (128 бит)",
      "kind": "chips",
