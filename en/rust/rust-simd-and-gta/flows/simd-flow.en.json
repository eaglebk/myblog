{
  "title": "How SIMD processes 4 <code>f32</code> values in a single instruction",
  "interval": 2600,
  "code": [
    "unsafe {",
    "    let va = _mm_loadu_ps(a.as_ptr());",
    "    let vb = _mm_loadu_ps(b.as_ptr());",
    "    let sum = _mm_add_ps(va, vb);",
    "    _mm_storeu_ps(out.as_mut_ptr(), sum);",
    "}"
  ],
  "nodes": [
    {
      "id": "mem",
      "name": "Memory (RAM)",
      "role": "4 f32 elements (128-bit)",
      "kind": "chips",
      "chips": ["[0]", "[1]", "[2]", "[3]"]
    },
    {
      "id": "reg",
      "name": "Vector Registers",
      "role": "XMM0 / XMM1 (128-bit)",
      "kind": "state",
      "defaultState": "empty"
    },
    {
      "id": "alu",
      "name": "Core SIMD ALU",
      "role": "1 vector instruction",
      "kind": "state",
      "defaultState": "idle"
    }
  ],
  "links": [
    { "id": "mr", "downLabel": "↓ _mm_loadu_ps", "upLabel": "↑ _mm_storeu_ps" },
    { "id": "ra", "downLabel": "↓ va, vb", "upLabel": "↑ sum (4 × f32)" }
  ],
  "steps": [
    {
      "label": "Load vectors",
      "explain": "<code>_mm_loadu_ps</code> loads 4 <code>f32</code> values (16 bytes) from memory into the 128-bit <code>XMM0</code> and <code>XMM1</code> vector registers without requiring strict alignment.",
      "lines": { "1": "active", "2": "active" },
      "nodes": {
        "mem": { "tone": "active", "chips": { "0": "current", "1": "current", "2": "current", "3": "current" } },
        "reg": { "tone": "active", "state": "va, vb loaded (4 f32 each)" },
        "alu": { "state": "idle" }
      },
      "arrows": {
        "mr": { "dir": "down", "tone": "active", "label": "↓ 2 × 128-bit from RAM" }
      }
    },
    {
      "label": "1 _mm_add_ps op",
      "explain": "<code>_mm_add_ps</code> adds all four <code>f32</code> pairs at the same time inside a single core using one machine instruction.",
      "lines": { "3": "active" },
      "nodes": {
        "mem": { "chips": { "0": "current", "1": "current", "2": "current", "3": "current" } },
        "reg": { "tone": "active", "state": "dispatch va & vb" },
        "alu": { "tone": "ok", "state": "4 additions in parallel!" }
      },
      "arrows": {
        "ra": [
          { "dir": "down", "tone": "active", "label": "↓ va, vb" },
          { "dir": "up", "tone": "ok", "label": "↑ sum (4 results)" }
        ]
      }
    },
    {
      "label": "Store result",
      "explain": "<code>_mm_storeu_ps</code> writes the 128-bit <code>sum</code> vector back into the <code>out</code> slice in one operation.",
      "lines": { "4": "ok" },
      "nodes": {
        "mem": { "tone": "ok", "chips": { "0": "accepted", "1": "accepted", "2": "accepted", "3": "accepted" } },
        "reg": { "tone": "ok", "state": "sum → out[0..4]" },
        "alu": { "state": "done" }
      },
      "arrows": {
        "mr": { "dir": "up", "tone": "ok", "label": "↑ 16 bytes to RAM" }
      }
    }
  ]
}
